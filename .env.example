# To separate your traces from other application
LANGSMITH_PROJECT=privy
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=

# LLM provider
DEEPSEEK_API_KEY=

# Reranking (Jev, TypeSafe)
TYPESAFE_API_KEY=

# Signs login tokens (backend). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Chat UI (Chainlit). Generate the secret with: uv run chainlit create-secret
CHAINLIT_AUTH_SECRET=
BACKEND_URL=http://localhost:8000
